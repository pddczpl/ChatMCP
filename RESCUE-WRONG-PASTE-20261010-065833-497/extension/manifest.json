{
  "manifest_version": 3,
  "name": "ChatMCP Hub Companion",
  "version": "1.4.0",
  "minimum_chrome_version": "120",
  "description": "Paired localhost tasks through ordinary ChatGPT chat, plus the existing manual MCP SuperAssistant compatibility bridge.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:3007/*", "https://chatgpt.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "ChatMCP Hub Companion",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["chat-route.js", "compat.js", "bridge.js", "composer.js", "browser-runner.js"],
      "css": ["bridge.css"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": ["http://127.0.0.1:3007/*"],
      "js": ["hub-wake.js"],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; object-src 'none'; connect-src http://127.0.0.1:3007; base-uri 'none'"
  }
}
