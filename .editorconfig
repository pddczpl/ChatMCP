root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Line endings are controlled by .gitattributes. Only the files whose
# interpreter cares are pinned here.
[*.sh]
end_of_line = lf

[*.{cmd,bat,ps1}]
end_of_line = crlf

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
