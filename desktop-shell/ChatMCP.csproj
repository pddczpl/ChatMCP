    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\assets\icons\chatmcp.ico</ApplicationIcon>
    <AssemblyName>ChatMCP</AssemblyName>
    <RootNamespace>ChatMCP.Desktop</RootNamespace>
    <Version>3.0.4</Version>
