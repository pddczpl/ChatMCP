    { "id": "sort-o-attached", "command": "sort -o{OUTSIDE}/sort-attached.txt a.txt", "shells": ["bash"], "effect": "{OUTSIDE}/sort-attached.txt", "why": "-o with an attached outside path" },
    { "id": "sort-compress-program", "command": "sort --compress-program=sh a.txt", "shells": ["bash"], "why": "--compress-program runs a program" },
    { "id": "sort-compress-abbrev", "command": "sort --compress-prog=sh a.txt", "shells": ["bash"], "why": "abbreviation of --compress-program" },
