    { "id": "sort-files0-from", "command": "sort --files0-from=list.txt", "shells": ["bash"], "why": "reads the file list from a file" },
    { "id": "sort-random-source", "command": "sort --random-source=.env -R a.txt", "shells": ["bash"], "why": "reads a protected file as a random source" },
    { "id": "sort-glob-option-injection", "command": "sort *.txt", "shells": ["bash"], "effect": "hostile.txt", "why": "the shell expands *.txt to a file literally named --output=hostile.txt, which sort takes as an option" },
    { "id": "sha256sum-check-list", "command": "sha256sum -c list.txt", "shells": ["bash"], "why": "-c opens every file that the list names" },
    { "id": "fc-history-editor", "command": "fc -e true", "shells": ["bash"], "why": "bash fc runs an editor on the command history" },
    { "id": "uniq-in-out","command": "uniq a.txt out-uniq.txt", "shells": ["bash", "powershell"], "effect": "out-uniq.txt", "why": "the second operand of uniq is an OUTPUT file" },
    { "id": "uniq-count-in-out", "command": "uniq -c a.txt {OUTSIDE}/uniq-out.txt", "shells": ["bash", "powershell"], "effect": "{OUTSIDE}/uniq-out.txt", "why": "uniq writing outside the workspace" },
    { "id": "file-compile-magic", "command": "file -C -m magic-x", "shells": ["bash", "powershell"], "effect": "magic-x.mgc", "why": "file -C compiles a magic file and writes <name>.mgc" },
