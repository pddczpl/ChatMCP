{
  "version": 1,
  "description": "Commands that Read Only mode must refuse (attacks) and commands it must still run (benign). Used by tests/verify-readonly-corpus.mjs against the real classifier, the real LocalTools and the real PermissionGate. {WORK} is the temporary workspace, {OUTSIDE} a folder next to it that is NOT part of the workspace. `shells` lists the shell styles the entry is asserted under (default: bash); `effect` names a file the command really creates when it is allowed to run, which the end-to-end positive control checks.",
  "workspaceFiles": {
    "a.txt": "alpha\nbeta\ngamma\nalpha\n",
    "b.txt": "one 2\ntwo 1\nthree 3\n",
    "notes.txt": "private notes\n",
    "list.txt": "a.txt\n",
    "data.csv": "id,name\n1,x\n2,y\n",
    "data.json": "{\"a\": 1, \"env\": \"prod\", \"name\": \"demo\"}\n",
    "package.json": "{\"name\": \"demo\", \"version\": \"1.0.0\"}\n",
    "prog.jq": ".a\n",
    "script.sed": "p\n",
    "magic-x": "0 string abc ABC-file\n",
    ".env": "SECRET_TOKEN=do-not-leak\n",
    "--output=hostile.txt": "this file name is an option once a shell glob expands it\n",
    "secrets.json": "{\"token\": \"LEAK-secrets-json-7d41\"}\n",
    "sub/credentials.json": "{\"key\": \"LEAK-sub-credentials-91b2\"}\n",
    "sub/secrets.json": "{\"token\": \"LEAK-sub-secrets-55c3\"}\n",
    "src/app.py": "# TODO: fix\ndef main():\n    return 1\n",
    "src/util.js": "export const add = (a, b) => a + b;\n"
  },
  "outsideFiles": { "o.txt": "OUTSIDE-FILE-CONTENT\n" },
  "junctions": [{ "name": "link", "target": "{OUTSIDE}" }],
  "baseline": { "version": "3.9.0", "note": "number of attack entries that analyzeCommand classified as read on the pristine v3.9.0 tree is recorded by the report, not asserted here" },
  "attacks": [
    { "id": "sed-e-command", "command": "sed '1e echo X > marker' a.txt", "shells": ["bash", "powershell"], "effect": "marker", "why": "GNU sed e command runs a shell command" },
    { "id": "sed-w-outside", "command": "sed -n 'w {OUTSIDE}/sed-w-outside.txt' a.txt", "shells": ["bash", "powershell"], "effect": "{OUTSIDE}/sed-w-outside.txt", "why": "w writes a file outside the workspace" },
    { "id": "sed-s-w-flag", "command": "sed 's/a/b/w out-sed.txt' a.txt", "shells": ["bash", "powershell"], "effect": "out-sed.txt", "why": "s///w writes a file" },
    { "id": "sed-r-notes", "command": "sed '1r notes.txt' a.txt", "shells": ["bash", "powershell"], "why": "r reads another file into the output" },
    { "id": "sed-r-env", "command": "sed '1r .env' a.txt", "shells": ["bash", "powershell"], "why": "r copies a protected file into the output" },
    { "id": "sed-R-env", "command": "sed -n '1R .env' a.txt", "shells": ["bash"], "why": "R reads a protected file line by line" },
    { "id": "sed-W-file", "command": "sed -s 'W out-sed-W.txt' a.txt", "shells": ["bash"], "effect": "out-sed-W.txt", "why": "W writes the first line of the pattern space to a file" },
    { "id": "sed-s-e-flag", "command": "sed 's/a/echo hi > out-sed-flag.txt/e' a.txt", "shells": ["bash"], "effect": "out-sed-flag.txt", "why": "s///e executes the result as a command" },
    { "id": "sed-s-ew-flags", "command": "sed 's|a|b|ew out-sed-ew.txt' a.txt", "shells": ["bash"], "why": "e and w flags combined" },
    { "id": "sed-e-option", "command": "sed -e '1e echo X > marker-e' a.txt", "shells": ["bash"], "effect": "marker-e", "why": "the e command through -e" },
    { "id": "sed-expression-long", "command": "sed --expression='1e echo X > marker-long' a.txt", "shells": ["bash"], "effect": "marker-long", "why": "the e command through --expression" },
    { "id": "sed-after-semicolon", "command": "sed 's/a/b/;e echo X > marker-semi' a.txt", "shells": ["bash"], "effect": "marker-semi", "why": "e hidden behind a harmless s command" },
    { "id": "sed-address-then-e", "command": "sed -n '/alpha/e echo X > marker-addr' a.txt", "shells": ["bash"], "effect": "marker-addr", "why": "e behind a regular-expression address" },
    { "id": "sed-delimiter-trick", "command": "sed 's,a,b,;1e echo X > marker-delim' a.txt", "shells": ["bash"], "effect": "marker-delim", "why": "custom delimiter then e" },
    { "id": "sed-newline-e", "command": "sed -n 'p\n1e echo X > marker-nl' a.txt", "shells": ["bash"], "effect": "marker-nl", "why": "e on a second script line" },
    { "id": "sed-split-fragments", "command": "sed -e 's/a/b\\' -e 'e id/' a.txt", "shells": ["bash"], "why": "fragments glued with a newline by sed itself" },
    { "id": "sed-script-file", "command": "sed -f script.sed a.txt", "shells": ["bash"], "why": "the script comes from a file that cannot be reviewed" },
    { "id": "sed-expression-protected-operand", "command": "sed -n -e p .env", "shells": ["bash", "powershell"], "why": "with -e every operand is a file: this prints .env" },
    { "id": "sed-inplace-e", "command": "sed -i '1e echo X > marker-i' a.txt", "shells": ["bash"], "effect": "marker-i", "why": "in-place edit must still not hide an e command" },
    { "id": "sed-inplace-e-flag", "command": "sed -i 's/a/b/e' a.txt", "shells": ["bash"], "why": "in-place edit with the e flag" },
    { "id": "sed-inplace-w-outside", "command": "sed -i 's/a/b/w ../x' a.txt", "shells": ["bash"], "why": "in-place edit writing outside through w" },
    { "id": "sed-inplace-w-env", "command": "sed -i '1w .env' a.txt", "shells": ["bash"], "why": "in-place edit overwriting a protected file through w" },
    { "id": "sort-o", "command": "sort -o out-sort.txt a.txt", "shells": ["bash"], "effect": "out-sort.txt", "why": "-o writes the sorted output to a file" },
