<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The shell's own session/ticket/new-window code, so this test runs what ships. webview2-smoke.mjs copies it next to the
         harness and passes -p:NativeShared=...; inside the repository it is found relative to this file. -->
    <NativeShared Condition="'$(NativeShared)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\native-shared</NativeShared>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(NativeShared)\HubLifecycle.cs" Link="HubLifecycle.cs" />
    <Compile Include="$(NativeShared)\HubSession.cs" Link="HubSession.cs" />
    <Compile Include="$(NativeShared)\OpenLink.cs" Link="OpenLink.cs" />
    <Compile Include="$(NativeShared)\WebViewBridge.cs" Link="WebViewBridge.cs" />
  </ItemGroup>
</Project>
