# Line endings
# - Text files are detected automatically. New files are stored with LF in the
#   repository; files already committed with CRLF are NOT rewritten by Git
#   (text=auto leaves CRLF-in-index files alone unless you run
#   "git add --renormalize").
# - Shell scripts must stay LF (Docker, WSL, Linux). Windows scripts stay CRLF.
* text=auto
*.sh   eol=lf
*.cmd  eol=crlf
*.bat  eol=crlf
*.ps1  eol=crlf
# The license text is distributed byte for byte (it is compared with the canonical Apache-2.0 text).
LICENSE eol=lf
NOTICE  eol=lf
# Vendored third-party license texts are kept byte for byte (stage.mjs copies them into the installer).
scripts/intelligence-runtime/licenses/*.LICENSE eol=lf
# The texts of what is compiled into rg.exe (PCRE2 and the Rust crates) are vendored unchanged. licenses/ripgrep/MANIFEST.json holds the SHA-256 and the git blob
# id of each, so no checkout may convert their line ends (core.autocrlf on a Windows runner would break every hash).
scripts/intelligence-runtime/licenses/ripgrep/** -text

# The recorded-shape model streams are compared byte for byte by the tests: no line-end conversion.
DATGOLD-HUB/tests/fixtures/streams/** -text

# Binary files
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.dpapi binary

# Retained acceptance evidence carries exact byte hashes. Preserve those bytes.
docs/agent-handoffs/evidence/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Vendored third-party browser code: keep out of language statistics
**/web/vendor/** linguist-vendored
*.min.js -diff linguist-vendored

# Generated data: the models.dev snapshot that scripts/update-model-catalog.mjs rebuilds (one line, hash-checked).
DATGOLD-HUB/lib/model-catalog.data.json -diff linguist-generated
