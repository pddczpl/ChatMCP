<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><Version>3.11.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../native-shared/HubLifecycle.cs" Link="HubLifecycle.cs" />
    <Compile Include="../../../native-shared/HubSession.cs" Link="HubSession.cs" />
    <Compile Include="../../../native-shared/OpenLink.cs" Link="OpenLink.cs" />
    <Compile Include="../../../native-shared/ReleaseVersion.cs" Link="ReleaseVersion.cs" />
    <Compile Include="../../../native-shared/UpdateContract.cs" Link="UpdateContract.cs" />
    <Compile Include="../../../native-shared/UpdatePackage.cs" Link="UpdatePackage.cs" />
    <Compile Include="../../../native-shared/UpdateStaging.cs" Link="UpdateStaging.cs" />
    <Compile Include="../../../native-shared/UpdateApplier.cs" Link="UpdateApplier.cs" />
    <Compile Include="../../../native-shared/PageMessage.cs" Link="PageMessage.cs" />
    <Compile Include="../../../native-shared/InstalledCopy.cs" Link="InstalledCopy.cs" />
    <Compile Include="../../../installer/InstallerEngine.cs" Link="InstallerEngine.cs" />
    <Compile Include="../../../installer/InstallTransaction.cs" Link="InstallTransaction.cs" />
    <Compile Include="../../../installer/InstallRecovery.cs" Link="InstallRecovery.cs" />
    <Compile Include="../../../installer/UpdateRun.cs" Link="UpdateRun.cs" />
    <Compile Include="../../../installer/UpdateWords.cs" Link="UpdateWords.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The cases that the Hub's code and the shell's code must read the same way (DATGOLD-HUB/tests/verify-release-vectors.mjs runs the same file). -->
    <None Include="../../../DATGOLD-HUB/tests/fixtures/release-verify-vectors.json" Link="release-verify-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The key file that ships, which the shell embeds: it must be one the shell can read whole. -->
    <None Include="../../../DATGOLD-HUB/lib/release-keys.json" Link="release-keys.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The result file the installer writes and the Hub reads, as literal text (DATGOLD-HUB/tests/verify-update-applied.mjs reads the same file). -->
    <None Include="../../../DATGOLD-HUB/tests/fixtures/update-result-vectors.json" Link="update-result-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Whether the Hub is doing work that an update would cut off: this rule, the installer's, and the page's port of it are held to one list of cases (DATGOLD-HUB/ui/tests/updates.test.mjs). -->
    <None Include="../../../DATGOLD-HUB/tests/fixtures/active-work-cases.json" Link="active-work-cases.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The recovery that the setup guide describes for an installation that needs it is run for real by Program.cs, from the text of the guide. -->
    <None Include="../../../docs/WINDOWS-SETUP.md" Link="WINDOWS-SETUP.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- The retained update that the lifecycle script makes on a hosted runner is made here too, by its own function, and repaired by the real repair (RecoverRefusalTests.cs). -->
    <None Include="../Test-NativeLifecycle.ps1" Link="Test-NativeLifecycle.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
