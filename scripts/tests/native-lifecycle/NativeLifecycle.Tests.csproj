<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><Version>3.10.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../native-shared/HubLifecycle.cs" Link="HubLifecycle.cs" />
    <Compile Include="../../../native-shared/HubSession.cs" Link="HubSession.cs" />
    <Compile Include="../../../native-shared/OpenLink.cs" Link="OpenLink.cs" />
    <Compile Include="../../../native-shared/ReleaseVersion.cs" Link="ReleaseVersion.cs" />
    <Compile Include="../../../native-shared/UpdateContract.cs" Link="UpdateContract.cs" />
    <Compile Include="../../../native-shared/UpdatePackage.cs" Link="UpdatePackage.cs" />
    <Compile Include="../../../native-shared/UpdateStaging.cs" Link="UpdateStaging.cs" />
    <Compile Include="../../../installer/InstallerEngine.cs" Link="InstallerEngine.cs" />
    <Compile Include="../../../installer/InstallTransaction.cs" Link="InstallTransaction.cs" />
    <Compile Include="../../../installer/UpdateRun.cs" Link="UpdateRun.cs" />
    <Compile Include="../../../installer/UpdateWords.cs" Link="UpdateWords.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The cases that the Hub's code and the shell's code must read the same way (CHATMCP-HUB/tests/verify-release-vectors.mjs runs the same file). -->
    <None Include="../../../CHATMCP-HUB/tests/fixtures/release-verify-vectors.json" Link="release-verify-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The result file the installer writes and the Hub reads, as literal text (CHATMCP-HUB/tests/verify-update-applied.mjs reads the same file). -->
    <None Include="../../../CHATMCP-HUB/tests/fixtures/update-result-vectors.json" Link="update-result-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Whether the Hub is doing work that an update would cut off: this rule, the installer's, and the page's port of it are held to one list of cases (CHATMCP-HUB/ui/tests/updates.test.mjs). -->
    <None Include="../../../CHATMCP-HUB/tests/fixtures/active-work-cases.json" Link="active-work-cases.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
