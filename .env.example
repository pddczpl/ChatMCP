# ChatMCP local-only environment variables.
# Never commit an API key or a populated .env file.
# Hub binds to 127.0.0.1 only. Hosted/public mode was removed.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional: configure Ollama/LM Studio through the UI with a loopback base URL.
# CHATMCP_STATE_DIR=C:\Users\YOUR_ACCOUNT\AppData\Local\ChatMCP\hub
# CHATMCP_NO_OPEN=1
# CHATMCP_BACKEND=local
# GitHub PR integration uses local 'gh auth login'; no GitHub token in this file.
