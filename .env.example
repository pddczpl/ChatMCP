# ChatMCP Environment Configuration Template
# Copy this file to .env and fill in your values: cp .env.example .env

# --- Mandatory for Public / Server Mode (Docker & Render) ---
# Owner login token (minimum 32 characters, minimum 12 distinct characters)
# Generate one with: openssl rand -base64 32
CHATMCP_OWNER_TOKEN=

# Hostnames allowed to connect (comma-separated, prevents DNS rebinding / host spoofing)
# For local Docker testing: localhost:10000,127.0.0.1:10000
# For VPS with domain: myagent.example.com
CHATMCP_ALLOWED_HOSTS=localhost:10000,127.0.0.1:10000

# Set to 1 only for local Docker testing over plain HTTP (without TLS reverse proxy)
# When set to 0 (default), cookies require HTTPS (__Host- prefix and Secure flag)
CHATMCP_ALLOW_INSECURE_HTTP=0

# Number of reverse proxies in front of ChatMCP (e.g., Cloudflare, Nginx)
# Defaults to 2 on Render, 0 for direct connection or docker port mapping
CHATMCP_TRUSTED_PROXY_HOPS=0

# --- Optional Git & Model Integrations ---
# GitHub Personal Access Token for cloning private repos / creating PRs
GITHUB_TOKEN=

# API keys for supported providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Initial model preset to select on start (openai | anthropic | gemini)
CHATMCP_AI_PRESET=
CHATMCP_AI_MODEL=
