<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\assets\icons\chatmcp.ico</ApplicationIcon>
    <AssemblyName>DatGoldSetup</AssemblyName>
    <RootNamespace>ChatMCP.Installer</RootNamespace>
    <Version>3.10.2</Version>
    <Authors>Phan Danh Đạt</Authors>
    <Company>DatGold Project</Company>
    <Product>DatGold Studio Setup</Product>
    <AssemblyTitle>DatGold Studio Setup</AssemblyTitle>
    <Description>DatGold Studio - Desktop Application Installer</Description>
  </PropertyGroup>

  <ItemGroup Condition="Exists('payload.zip')">
    <EmbeddedResource Include="payload.zip">
      <LogicalName>ChatMCP.Installer.payload.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\native-shared\HubLifecycle.cs" Link="HubLifecycle.cs" />
    <Compile Include="..\native-shared\HubSession.cs" Link="HubSession.cs" />
  </ItemGroup>
</Project>
